venv/
.venv/
env/

# ── IDE ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Environment ────────────────────────────────
.env
.env.local

# ── Data (keep samples, ignore large files) ────
data/raw/
data/cache/
*.parquet
*.h5

# ── ML artifacts ───────────────────────────────
models/embeddings_cache/
mlruns/
*.ckpt
*.pt
*.bin

# ── Reports (generated) ───────────────────────
reports/*.png
reports/metrics.json

# ── OS ─────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker volumes ─────────────────────────────
pgdata/
qdrant_data/

# ── Secrets ────────────────────────────────────
*.pem
*.key
.env.*
!.env.example

# ── Docs (keep thesis docs) ───────────────────
# Do NOT ignore .docx / .pptx – they are thesis materials
*.pdf\nexperiment_output.log\nphase2_output.log\ngenerate_ppt_backup.py
# ── Docs & reports ─────────────────────────────
*.md
*.docx
*.pptx
*.pdf
*.log
reports/
results/
