# ──────────────────────────────────────────────
#  VulnTriage – environment configuration
# ──────────────────────────────────────────────
NVD_API=your_nvd_api_key_here

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=vulntriage
POSTGRES_PASSWORD=vulntriage_dev
POSTGRES_DB=vulntriage
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vulntriage:vulntriage_dev@localhost:5433/vulntriage

# ── Qdrant ─────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ── Embedding model ───────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Text model ─────────────────────────────────
TEXT_MODEL_NAME=distilbert-base-uncased
TEXT_MODEL_MODE=pretrained   # pretrained | finetune

# ── Experiment ─────────────────────────────────
TRAIN_CUTOFF_DATE=2024-12-31
RANDOM_SEED=42
TOP_K_VALUES=25,50,100

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Safety ─────────────────────────────────────
SAFETY_NO_EXPLOIT_CODE=true

# ── API protection ─────────────────────────────
# When set, write endpoints and LLM brief generation require an X-API-Key header.
VULNTRIAGE_API_KEY=
LLM_RATE_LIMIT_PER_MINUTE=10
BRIEF_CACHE_TTL_HOURS=168

# ── Asset matching ─────────────────────────────
# true = ask OSV whether a Debian/Alpine package revision already carries the
# fix. Sends package names and versions to api.osv.dev.
OSV_BACKPORT_CHECK=false
